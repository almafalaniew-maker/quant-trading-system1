# Copy to .env, fill in, and keep it out of git (.gitignore already covers it).
# Generate keys at https://app.alpaca.markets -> Paper Trading -> API Keys.

ALPACA_API_KEY=your_key_here
ALPACA_API_SECRET=your_secret_here

# Live trading needs BOTH this and the --live flag. Two independent switches,
# because each one alone is easy to leave on by accident.
QTS_ALLOW_LIVE=no

# Unset (the default) means the PAPER endpoint. Setting this to any value points
# the same code at real money. Leave it alone until paper has run for weeks.
# QTS_REAL_MONEY=1
